# Base URL of the ABC Ecommerce API (including /api/v1).
# Development: the API runs on port 4000. In production this MUST be set explicitly
# (it is inlined at build time) to the deployed API, e.g. https://api.example.com/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# The admin/storefront app itself runs on http://localhost:3100 (npm run dev / npm start).
# Add that origin to the API's CORS_ORIGIN, e.g. CORS_ORIGIN=http://localhost:3100
