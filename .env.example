# Variables read by docker compose (copy to .env in this folder; .env is git-ignored).

# Host port for MongoDB, bound to 127.0.0.1 only. Change it if 27017 is already used on your machine
# (for example by a locally installed MongoDB service) and use the same port in backend/.env.
MONGO_HOST_PORT=27017
# MONGO_CONTAINER_NAME=ecommerce-mongo

# Only needed with docker-compose.auth.yml (authenticated MongoDB). Use your own values:
#   MONGO_ROOT_USERNAME : any account name
#   MONGO_ROOT_PASSWORD : long random value, e.g.  openssl rand -base64 24
#   MONGO_REPLICA_KEY   : keyfile content, 6-1024 base64 chars on ONE line, e.g.  openssl rand -base64 48 | tr -d '\n'
# MONGO_ROOT_USERNAME=
# MONGO_ROOT_PASSWORD=
# MONGO_REPLICA_KEY=
