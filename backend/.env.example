NODE_ENV=development
PORT=4000
# Replica set is REQUIRED (orders use transactions). docker compose up -d mongo provides one.
MONGODB_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0&directConnection=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:3000
# Used only by `npm run seed:admin`
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
