NODE_ENV=development
PORT=4000

# Replica set is REQUIRED (orders use transactions). `docker compose up -d mongo` (repo root) provides one.
# The default compose file binds MongoDB to 127.0.0.1 only. If 27017 is already used on your machine
# (for example by a locally installed MongoDB service) set MONGO_HOST_PORT in the root .env and use that
# port here, e.g. mongodb://127.0.0.1:27018/ecommerce?...
MONGODB_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0&directConnection=true
# With docker-compose.auth.yml (authenticated MongoDB) use the credentials you chose in the root .env:
# MONGODB_URI=mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@localhost:27017/ecommerce?replicaSet=rs0&directConnection=true&authSource=admin
# (URL-encode special characters in the password.)

# JWT signing secrets. These two values are PUBLIC placeholders for local development only.
# In production the API REFUSES to start with them (or with any "change-me…"/placeholder/weak value) and
# requires two DIFFERENT, random secrets of at least 32 characters. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# A rotated refresh token stays usable this long (seconds) so concurrent tabs / a lost response do not
# log the user out. Replaying it after this window is treated as token theft and revokes that session.
REFRESH_GRACE_SECONDS=10

# Comma-separated list of allowed browser origins (exact match). In production use your real https origin(s);
# localhost is rejected in production.
CORS_ORIGIN=http://localhost:3100

# Rate limits per 15 minutes (per client IP unless noted). Defaults shown.
# AUTH_RATE_LIMIT_MAX=30            # login + register
# REFRESH_RATE_LIMIT_MAX=120        # /auth/refresh per IP
# REFRESH_TOKEN_RATE_LIMIT_MAX=30   # /auth/refresh per refresh-token cookie
# API_RATE_LIMIT_MAX=600            # whole /api/v1

# API docs (Swagger UI at /api-docs, OpenAPI JSON at /api-docs.json). Off by default in production.
# SWAGGER_ENABLED=true
# SWAGGER_SERVER_URL=https://api.example.com
# SWAGGER_USER=
# SWAGGER_PASSWORD=

# Used only by `npm run seed:admin`
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
